# Copy to .env (never commit .env). All of these are public, browser-safe values.

# Supabase: Project Settings > API (use the publishable key, never the secret/service role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile site key (leave empty until Turnstile is set up; the widget is then hidden)
VITE_TURNSTILE_SITE_KEY=

# Web Push public key (VAPID_PUBLIC_KEY from `node scripts/generate-vapid-keys.mjs`)
VITE_VAPID_PUBLIC_KEY=
