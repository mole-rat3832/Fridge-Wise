# Copy to .env (never commit .env). All of these are public, browser-safe values.

# Supabase: Project Settings > API (use the publishable key, never the secret/service role key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Turnstile site key (leave empty locally unless localhost is an allowed hostname;
# the widget is then hidden). The production value is in netlify.toml.
VITE_TURNSTILE_SITE_KEY=

# Optional Web Push public key. Leave empty: the app reads it from the app_public_config table
# (send-reminders creates the key pair in Supabase Vault on first use).
VITE_VAPID_PUBLIC_KEY=
